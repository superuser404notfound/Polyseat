# polyseat — Seat-Session (headless)
#
# Ein einziger virtueller Ausgang. Auflösung und Bildrate werden später pro
# verbundenem Client umgeschaltet (SUNSHINE_CLIENT_WIDTH/HEIGHT/FPS), für M1
# steht sie fest.
output HEADLESS-1 resolution 1920x1080@60Hz position 0,0

# Sunshine erfährt WAYLAND_DISPLAY erst, wenn sway den Socket geöffnet hat.
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_SESSION_TYPE
exec systemctl --user start polyseat-sunshine.service

# Etwas Sichtbares, damit der erste Stream nicht schwarz ist.
exec foot
