+/**
+ * Ask a capture source to hand out frames in a given colour.
+ *
+ * Only works for a source created with
+ * wlr_ext_image_capture_source_v1_create_with_scene_output() or
+ * wlr_ext_image_capture_source_v1_create_with_scene_node(), which composite
+ * the scene again into a private output and can therefore convert. Returns
+ * false for any other source, and for a colour the source cannot present.
+ *
+ * Pass NULL to go back to the default, which is sRGB.
+ *
+ * render_format may be DRM_FORMAT_INVALID, in which case a format wide enough
+ * for the transfer function is chosen.
+ */
+bool wlr_ext_image_capture_source_v1_set_image_description(
