+bool wlr_ext_image_capture_source_v1_set_image_description(
+		struct wlr_ext_image_capture_source_v1 *base,
+		const struct wlr_output_image_description *image_desc,
+		uint32_t render_format) {
+	if (base->impl != &source_impl) {
+		// Only a source that composites the scene again can honour this. The
+		// raw output source hands out the output's own buffer and has nothing
+		// to convert with.
+		return false;
+	}
+
+	struct scene_source *source = wl_container_of(base, source, base);
+
+	if (image_desc == NULL) {
+		source->has_image_description = false;
+		return true;
+	}
+
+	if (!(source->output.supported_primaries & image_desc->primaries) ||
+			!(source->output.supported_transfer_functions & image_desc->transfer_function)) {
+		return false;
+	}
+
+	if (render_format == DRM_FORMAT_INVALID) {
+		render_format = image_desc->transfer_function == WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ ?
+			DRM_FORMAT_XRGB2101010 : DRM_FORMAT_XRGB8888;
+	}
+
+	source->image_description = *image_desc;
+	source->render_format = render_format;
+	source->has_image_description = true;
+	return true;
+}
+
 static void source_init(struct scene_source *source, struct wlr_scene *scene,
 		struct wl_event_loop *event_loop, struct wlr_allocator *allocator,
 		struct wlr_renderer *renderer) {
@@ -329,6 +377,19 @@ static void source_init(struct scene_source *source, struct wlr_scene *scene,
 
 	source->scale = 1;
 
+	// What this private output presents, rather than what any panel behind it
+	// could show. There is no panel: this output exists only to be captured,
+	// and its single consumer is the client that asked for the capture and
+	// said which colour it wants. Advertising these here is therefore a
+	// statement about the frames handed out, not a claim about hardware.
+	source->output.supported_primaries =
+		WLR_COLOR_NAMED_PRIMARIES_SRGB |
+		WLR_COLOR_NAMED_PRIMARIES_BT2020;
+	source->output.supported_transfer_functions =
+		WLR_COLOR_TRANSFER_FUNCTION_SRGB |
+		WLR_COLOR_TRANSFER_FUNCTION_GAMMA22 |
+		WLR_COLOR_TRANSFER_FUNCTION_ST2084_PQ;
+
 	source->scene_output_destroy.notify = source_handle_scene_output_destroy;
 	wl_signal_add(&source->scene_output->events.destroy, &source->scene_output_destroy);
 
