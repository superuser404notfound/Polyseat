# Maintainer: rooky <superuser404@tuta.com>

pkgname=polyseat
pkgver=0.8.0
pkgrel=1
pkgdesc="Several people playing on one Linux PC at once, each in an isolated seat streamed to their own Moonlight client"
arch=('x86_64')
url="https://github.com/superuser404notfound/Polyseat"
license=('GPL-3.0-or-later')

# What the daemon talks to. Everything a seat needs is installed inside the seat
# by the daemon itself, so none of that belongs here: a host running Polyseat
# needs no Steam, no Sway and no Sunshine of its own.
#
# Three, and namcap says all three may not be needed. It is wrong about all
# three, because it finds dependencies by reading ELF links and shebangs and
# these are none of those: incus is a socket the daemon speaks to, bpftrace is
# what the uhid observer runs, and python is what the input broker is written in.
#
# systemd, iproute2 and util-linux were listed here and are not any more. The
# daemon calls systemctl, prepare.sh calls ip and both call findmnt, so they are
# genuinely used, and all three are members of `base`, which every Arch
# installation has. Listing them is noise that namcap flags and nobody acts on.
depends=('incus' 'bpftrace' 'python')

makedepends=('go' 'git')

# What check() needs, which is not what the daemon needs. The seat tests run the
# real Python helpers rather than a stand-in: boxart.py imports Pillow, the icon
# tests shell out to rsvg-convert, and the gamepad pointer tests import evdev at
# the top of the helper. Without these, makepkg fails in check() on a machine
# that has everything the package actually requires, which is a bad way to meet
# a project.
checkdepends=('python-pillow' 'librsvg' 'python-evdev')

optdepends=(
  'nvidia-container-toolkit: required on NVIDIA hosts, mirrors the driver into each seat'
  'nvidia-utils: required on NVIDIA hosts, carries the two libraries NVENC needs'
  'lib32-nvidia-utils: on NVIDIA hosts, or 32 bit games will not find the GPU'
)

install=polyseat.install

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('436a1f33234af240a1f8fc44ac69a4333a9d487a5e809c0b4b5c105ed21aeddc')

_src="Polyseat-$pkgver"

build() {
  cd "$_src"

  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"

  # The version is stamped the same way host/install.sh stamps it, except that
  # here it comes from pkgver rather than from git: a source tarball has no
  # history to ask. Without this the daemon calls itself "dev", the interface
  # shows that, and the update check refuses to run because a build that cannot
  # name itself as a release cannot be compared with one.
  go build -o polyseatd \
    -ldflags "-linkmode=external -X github.com/superuser404notfound/Polyseat/internal/version.Version=v$pkgver" \
    ./cmd/polyseatd
}

check() {
  cd "$_src"

  # The library tests want a filesystem that can share blocks and skip loudly
  # without one, and a build directory is wherever makepkg happens to be. They
  # are skipped here rather than faked; CI runs them against real btrfs.
  go test ./... 2>&1
}

package() {
  cd "$_src"

  install -Dm755 polyseatd "$pkgdir/usr/bin/polyseatd"

  # The machine half, as a command rather than as a script somebody has to find
  # in a checkout they do not have. A package may place files and may not
  # initialise Incus, write to /etc/subuid or put an account in a group, so this
  # is what the post-install message asks people to run.
  install -Dm755 host/prepare.sh "$pkgdir/usr/bin/polyseat-prepare"

  # The way out, and the file the interface's remove button runs. Without it a
  # package that installs in one command can only be removed with pacman, which
  # knows nothing about the order this has to come apart in: the daemon has to
  # stop before its seats are touched, or Incus is left with a "Stopping
  # instance" task that never finishes. It also removes itself, which is why it
  # runs from a copy of itself; see the top of the file.
  install -Dm755 host/uninstall.sh "$pkgdir/usr/bin/polyseat-uninstall"

  # The other two host tools the readme sends people to, for the same reason.
  # Neither is a development aid: lan-bridge turns the uplink into a bridge,
  # which is what local multiplayer between the host and a seat needs, and
  # check-hardening reports the console and device exposures that docs/security.md
  # describes. Somebody who installed the package has no checkout to find them
  # in, and until they were here the readme named two files that machine did not
  # have. Both stand on their own and read nothing from a source tree.
  install -Dm755 host/lan-bridge.sh "$pkgdir/usr/bin/polyseat-lan-bridge"
  install -Dm755 host/check-hardening.sh "$pkgdir/usr/bin/polyseat-check-hardening"

  # The input broker and its helpers. /usr/lib rather than /usr/local/lib, which
  # is where a checkout install puts them; the daemon looks in both and prefers
  # the local one, so a package and a checkout on one machine behave the way a
  # shell would.
  for helper in broker.py device_owner.py uhid_observer.py fakeudev.py; do
    install -Dm755 "spike/m2-input-broker/$helper" "$pkgdir/usr/lib/polyseat/$helper"
  done

  # The unit ships pointing at /usr/local/bin, which is right for the checkout
  # install that writes it there. A package owns /usr/bin.
  sed 's|/usr/local/bin/polyseatd|/usr/bin/polyseatd|' host/polyseatd.service \
    > "$srcdir/polyseatd.service"
  install -Dm644 "$srcdir/polyseatd.service" "$pkgdir/usr/lib/systemd/system/polyseatd.service"

  # The number in the name matters and is not cosmetic. At 70 it sorted before
  # 70-uaccess.rules, which put the tag it had just stripped straight back on.
  install -Dm644 host/72-polyseat-hide.rules \
    "$pkgdir/usr/lib/udev/rules.d/72-polyseat-hide.rules"

  # uhid at boot, owned by the package so that pacman -Rns takes it away again.
  # It used to be written by polyseat-prepare into /etc, where nothing owned it
  # and removing the package left it behind loading a module for something that
  # was gone. systemd reads /usr/lib/modules-load.d as well as /etc.
  install -Dm644 host/polyseat-modules-load.conf \
    "$pkgdir/usr/lib/modules-load.d/polyseat.conf"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  for doc in README.md CHANGELOG.md SECURITY.md docs/architecture.md docs/security.md \
             docs/installation.md docs/amd.md; do
    install -Dm644 "$doc" "$pkgdir/usr/share/doc/$pkgname/$(basename "$doc")"
  done
}
