# Polyseat - Faugus Launcher, as a seat gets it.
#
# The AUR recipe of the same release with its source pinned, built once with
# build.sh and published as a package, because Faugus is in no Arch repository
# and a seat has neither a compiler nor an AUR helper. Under its own name, so
# that one the player builds from the AUR later simply takes its place.
#
# Built with build.sh, which is the only supported way: a seat gets the
# finished package rather than this recipe.

pkgname=faugus-launcher
pkgver=2.5.6
pkgrel=1
pkgdesc="A simple and lightweight app for running Windows games using UMU-Launcher"
arch=('any')
url="https://github.com/Faugus/faugus-launcher"
license=('MIT')

depends=('python-gobject' 'python-requests' 'python-pillow' 'python-vdf'
         'python-psutil' 'icoextract' 'gtk4' 'libadwaita' 'libmanette')
makedepends=('meson' 'gettext')

source=("$pkgname-$pkgver.tar.gz::https://github.com/Faugus/faugus-launcher/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('fab1a281d1aae671a0fe7a41059e1eb65f0588477e1cf2364bd89313b5022c88')

build() {
  cd "$pkgname-$pkgver"
  arch-meson . build
  meson compile -C build
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" meson install -C build
}
