+  void proc_t::resume(std::shared_ptr<rtsp_stream::launch_session_t> launch_session) {
+    if (_app_id == 0) {
+      return;
+    }
+
+    set_client_env(_env, *launch_session);
+
+    // Only those that ran at launch, which are the ones whose undo is still owed.
+    // A failure is logged and not fatal: a stream at the wrong size is better than none.
+    auto ran = static_cast<std::size_t>(_app_prep_it - _app_prep_begin);
+    auto count = std::min(_app.global_prep_count, ran);
+
+    for (std::size_t i = 0; i < count; ++i) {
+      auto &cmd = _app.prep_cmds[i];
+      if (cmd.do_cmd.empty()) {
+        continue;
+      }
+
+      std::error_code ec;
+      boost::filesystem::path working_dir = _app.working_dir.empty() ?
+                                              find_working_directory(cmd.do_cmd, _env) :
+                                              boost::filesystem::path(_app.working_dir);
+      BOOST_LOG(info) << "Resuming, executing Do Cmd: ["sv << cmd.do_cmd << ']';
+      auto child = platf::run_command(cmd.elevated, true, cmd.do_cmd, working_dir, _env, _pipe.get(), ec, nullptr);
+      if (ec) {
+        BOOST_LOG(warning) << "Couldn't run ["sv << cmd.do_cmd << "]: System: "sv << ec.message();
+        continue;
+      }
+
+      child.wait(ec);
+      if (ec) {
+        BOOST_LOG(warning) << '[' << cmd.do_cmd << "] wait failed with error code ["sv << ec << ']';
+        continue;
+      }
+      if (auto ret = child.exit_code(); ret != 0) {
+        BOOST_LOG(warning) << '[' << cmd.do_cmd << "] exited with code ["sv << ret << ']';
+      }
+    }
+  }
