# Polyseat - seat session (headless)
#
# Generated by polyseatd. Edits are overwritten the next time the seat is
# provisioned.

set $mod Mod4
set $term foot
set $menu /usr/local/bin/polyseat-launcher toggle
set $files thunar

# A single virtual output. The resolution below is what the session comes up
# with; polyseat-resize changes it per connected client and puts this value
# back afterwards, so the two have to agree.
output HEADLESS-1 resolution {{.Resolution}} position 0,0

# Something other than black behind the windows, so an empty desktop looks
# like a desktop rather than a broken stream.
output HEADLESS-1 background #1b2430 solid_color

{{.Keyboard}}

# The pointer in a seat is never a mouse. It is Sunshine's virtual one, which
# exists only while somebody streams, or the gamepad helper's. Both leave the
# pointer exactly where they last moved it, and wlroots composites the cursor
# into the very picture Sunshine captures, so a pointer nobody is using stays
# drawn there until the next pointer event redraws it. Reported from the couch
# as a mouse standing in the middle of the screen that only goes away after a
# move and a click.
#
# Ten seconds of stillness and it is gone; any movement brings it straight
# back. Confirmed on a 4K stream out of this seat before it was written down,
# at three seconds, which turned out to be short enough to take the pointer
# away from somebody who was still using it.
seat * hide_cursor 10000

# Sunshine only learns WAYLAND_DISPLAY once sway has opened the socket.
#
# DISPLAY belongs in this list for a reason that is easy to miss. Steam is an
# X11 application, so every app Sunshine starts needs it, and Sunshine runs as
# a user unit whose environment is whatever the user manager holds. The sway
# unit sets DISPLAY, but that only reaches sway and the children sway starts
# itself; without importing it here the user manager has none, and Steam
# reports "Unable to open a connection to X". Imported rather than written into
# the Sunshine unit so that the value is whatever sway actually settled on.
#
# One line, because two exec lines are two processes that sway starts at once,
# and nothing then says the import has happened by the time Sunshine is
# started. A Sunshine that wins that race starts without the display it
# captures.
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_SESSION_TYPE DISPLAY && systemctl --user start polyseat-sunshine.service

# The desktop itself. A seat that streams only a terminal cannot be used to
# install anything or to start a launcher that is not in the Sunshine app list,
# which is the whole reason these are here.
exec waybar
exec foot -- /usr/local/bin/polyseat-welcome

# Open the launcher straight away, so that picking "Desktop" in Moonlight lands
# on a grid of things to start rather than on a terminal. Sunshine hides it
# again when a client picks anything else.
exec /usr/local/bin/polyseat-launcher show

# Steam, started straight away, so that the first game of the day does not begin
# with a cold Steam unpacking itself. It comes up inside gamescope, because the
# in-game overlay does not work under rootless Xwayland at all; polyseat-steam
# has the measurement.
#
# Silently, and without Big Picture. A seat nobody has picked Steam in then
# holds 218 MB less video memory, which is worth having on a machine where two
# seats share one card, and the window is about six hundred milliseconds to
# build once Steam is warm - which it is, from here on. Moonlight's Steam entry
# is what asks for it. The daemon starts this same script when it has had to
# close an idle Steam, so the two never disagree about the arguments.
exec /usr/local/bin/polyseat-steam

# For the client that has no keyboard and no mouse, which is most of them.
# squeekboard stays hidden until asked for; the pointer helper does nothing at
# all until two of Select, Start and Guide are held together for a second, so a
# gamepad in a game behaves exactly as it did before.
exec squeekboard

# Started again if it dies after running for a while, because nothing else
# would: this line runs once per session, and a helper that is gone leaves
# somebody on a television with no pointer until the seat restarts. It died
# that way when a pad vanished during a rescan, which is fixed in the helper;
# this is for whatever the next one is.
#
# Not started again if it dies within half a minute of starting. That is a
# helper that cannot run at all here, no uinput or no evdev, and restarting it
# would only write the same traceback into the journal every two seconds for
# the rest of the session.
exec sh -c 'while :; do began=$(date +%s); /usr/local/bin/polyseat-pad-pointer && exit 0; [ $(($(date +%s) - began)) -ge 30 ] || exit 1; sleep 2; done'

# Puts Big Picture back to fullscreen when sway takes it away, which is what
# quitting a game does: a game goes fullscreen, sway allows one such window per
# workspace, and Big Picture is left tiled when the game exits. The rule below
# fires when a window is mapped and cannot see that.
#
# **Only for a Steam outside gamescope, and kept on purpose.** Inside gamescope
# sway sees one window with the app_id gamescope and never a Steam window at
# all, so neither this nor the Big Picture rule below matches anything on the
# ordinary path. They stay for the paths polyseat-steam cannot avoid: gamescope
# failing on its second try, which leaves Steam on the session's own X server,
# and a Steam that would not close, where it opens Big Picture there anyway.
# That is a player with a television and a broken arrangement, and a Big
# Picture that owns the screen is the difference between a worse evening and
# no evening. What it costs otherwise is one process asleep on sway's socket.
exec /usr/local/bin/polyseat-bigpicture-watch

# Give squeekboard its layout before anybody connects. Not cosmetic: until it
# has one the compositor publishes an empty keymap and every Vulkan application
# in the seat crashes on startup, which takes the framerate cap down with it.
# polyseat-keyboard explains the whole of it.
exec /usr/local/bin/polyseat-keyboard prime

# --- keys -------------------------------------------------------------------
#
# Deliberately close to sway's stock bindings. Somebody who has used sway
# should not have to learn this file, and somebody who has not gets the same
# answers from any sway documentation. polyseat-welcome prints the short list
# into the first terminal.

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+e exec $files
bindsym $mod+q kill
bindsym $mod+k exec /usr/local/bin/polyseat-keyboard
bindsym $mod+Shift+c reload

# Focus, move, split, layout, floating: stock sway.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

floating_modifier $mod normal

# There is no login manager to fall back to, and exiting sway takes the whole
# session down with it, Sunshine included. Made deliberate rather than a stray
# keystroke: the daemon is the thing that stops a seat.
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'This ends the session and disconnects everyone streaming from this seat.' \
    -B 'End the session' 'swaymsg exit'

# --- windows ----------------------------------------------------------------
#
# Big Picture is meant to own the screen. Without this it opens as an ordinary
# tiled window next to the terminal, which is not what anybody asked for when
# they picked it in Moonlight.
#
# Matched on a fragment rather than the whole title, because Steam translates
# it: "Steam Big Picture Mode" in English, "Big-Picture-Modus" in German. The
# anchored English version matched nothing at all in a German seat, which is
# what let the reported bug through. polyseat-bigpicture-watch carries the same
# pattern, and a test holds the two to it.
#
# This and the rules for Steam's small windows further down match a Steam
# outside gamescope only, which is a fallback now; the exec of the watcher
# above says when that happens and why they stay.
for_window [class="^steam$" title="[Bb]ig[ _-][Pp]icture"] fullscreen enable

# Steam lives in gamescope, and gamescope lives on a workspace of its own.
#
# Not cosmetic. gamescope is fullscreen for as long as it exists, so on a shared
# workspace it would sit on top of the desktop this session also provides: the
# terminal, the launcher grid, Firefox, Lutris, everything a player installs.
# Two workspaces keep both, and the Moonlight entries switch between them, which
# is why "Desktop" and "Steam Big Picture" now each begin with a swaymsg.
assign [app_id="^gamescope$"] workspace number 2
for_window [app_id="^gamescope$"] fullscreen enable

# Steam's small windows tile badly and end up as tall thin strips.
for_window [class="^steam$" title="^Friends List$"] floating enable
for_window [class="^steam$" title="^Steam - News"] floating enable
for_window [class="^steam$" title=".* - Chat$"] floating enable
for_window [title="^Steam Keyboard$"] floating enable

for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable

default_border pixel 2
client.focused #4c7899 #285577 #ffffff #2e9ef4 #285577
