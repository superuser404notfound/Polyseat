[Unit]
Description=polyseat: headless Sway session
After=pipewire.service wireplumber.service

[Service]
Type=simple
Environment=WLR_BACKENDS=headless,libinput
# /dev/input is empty at startup - without this the libinput backend aborts.
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_RENDERER=gles2
Environment=WLR_HEADLESS_OUTPUTS=1
Environment=LIBSEAT_BACKEND=noop
Environment=XDG_SESSION_TYPE=wayland
# Steam is an X11 application, and sway only starts Xwayland once the
# first X client appears. Until then sway's own environment carries no
# DISPLAY, so children inherit none and Steam only shows "Unable to open
# a connection to X". Nothing else uses X inside the container, so :0 is
# always the right display.
Environment=DISPLAY=:0
# Where flatpak puts the .desktop files of what the player installed.
#
# Arch adds this through /etc/profile.d, which a systemd user unit never reads,
# so without it the session sees only the system directories. The symptom is
# quiet and looks like a broken install: `flatpak install` succeeds, the
# application runs from a terminal, and it is missing from the launcher.
Environment=XDG_DATA_DIRS=/home/player/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
# The graphics vendor's own variables are not here. They differ per machine and
# arrive as the 20-gpu.conf drop-in beside this file, because setting NVIDIA's
# GBM_BACKEND on a Mesa system points GBM at a backend that does not exist.
# Finding from M0: without this variable SDL does not notice a pad that only
# arrives in the container at runtime.
Environment=SDL_JOYSTICK_DISABLE_UDEV=1
ExecStart=/usr/bin/sway
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
