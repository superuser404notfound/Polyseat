// Polyseat - the bar in a seat session
//
// Generated by polyseatd. Edits are overwritten the next time the seat is
// provisioned.
//
// Deliberately thin. This is a games machine that happens to have a desktop,
// so the bar exists to say which seat you are on, what time it is, and how to
// open something. Modules for hardware a container does not have (battery,
// backlight, a real network interface) are left out rather than shown empty.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window", "custom/close"],
    "modules-right": ["custom/keyboard", "pulseaudio", "cpu", "memory", "custom/seat", "clock"],

    "custom/launcher": {
        "format": "  Apps ",
        "tooltip": false,
        "on-click": "/usr/local/bin/polyseat-launcher toggle"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    // Closes the focused window, the one whose title stands just left of it.
    // sway draws no close buttons, and Super+Q is no use to a client without
    // a keyboard. A click on the bar does not move focus, and sway's
    // focus_follows_mouse is off for this reason: otherwise the pointer on its
    // way up here would focus whatever window lies under the button, and the
    // button would close that one instead.
    "custom/close": {
        "format": " Close ",
        "tooltip": false,
        "on-click": "swaymsg kill"
    },

    // Reachable by pointer, because whoever needs the keyboard is by
    // definition streaming from something that has none, and Super+K is not
    // an option for them.
    "custom/keyboard": {
        "format": " Keyboard ",
        "tooltip": false,
        "on-click": "/usr/local/bin/polyseat-keyboard"
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "ram {percentage}%",
        "interval": 10
    },

    "custom/seat": {
        "format": "{{.Seat}}",
        "tooltip": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt>{calendar}</tt>"
    }
}
