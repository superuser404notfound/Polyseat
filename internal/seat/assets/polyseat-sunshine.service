[Unit]
Description=polyseat: Sunshine
After=polyseat-sway.service
BindsTo=polyseat-sway.service

[Service]
Type=simple
# The graphics vendor's own variables arrive as the 20-gpu.conf drop-in beside
# this file, since they differ per machine. See polyseat-sway.service.
Environment=SDL_JOYSTICK_DISABLE_UDEV=1
# The Steam pad is for Steam alone. polyseat-steam-pad keeps it, silent while
# anything but Steam is in front, and a game that listens to the first pad it
# finds could find that one. polyseat-steam drops this again for Steam.
Environment=SDL_GAMECONTROLLER_IGNORE_DEVICES=0x046d/0xc21d
# Waits for the Wayland session itself - see sunshine-run.sh.
ExecStart=/usr/local/bin/polyseat-sunshine-run
Restart=on-failure
RestartSec=5
