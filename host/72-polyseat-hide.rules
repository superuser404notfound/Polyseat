# Polyseat: virtual input devices belonging to a seat must never reach the
# host desktop.
#
# This rule decides by name, and that is a known weakness rather than the
# design. The list held for exactly as long as Sunshine was the only thing in a
# seat creating input devices. The first other one, a gamepad to mouse mapper
# called "antimicrox Mouse Emulation", matched nothing here and its devices
# reached the host desktop with the uaccess tag still on them: a controller in
# a seat moving the host's cursor.
#
#   polyseat:*      Polyseat's own, including the pointer and keys a seat makes
#                   out of its gamepad
#   *passthrough*   Sunshine's keyboard, mouse, touch and pen
#   Sunshine*       Sunshine's gamepads, named after the emulated model, e.g.
#                   "Sunshine X-Box One (virtual) pad (seat1)"
#   libvirtualhid*  the same devices from a Sunshine that has moved its virtual
#                   input to the libvirtualhid library. Measured on 2026-09-05
#                   with two seats side by side, one on the packaged build and
#                   one on a newer one:
#
#                       Mouse passthrough (vince)     packaged
#                       libvirtualhid Mouse           newer
#
#                   Two things change at once and this file can only fix the
#                   first. The name no longer matches anything above, so the
#                   fast path stopped firing; the broker still caught the
#                   devices, but a poll interval later, and that interval is
#                   long enough for a client's mouse to reach the host desktop.
#                   It was seen doing exactly that.
#
#                   The second is not fixable here: the seat tag is gone too.
#                   Sunshine used to read XDG_SEAT and append "(seatname)", and
#                   the newer source contains no reference to XDG_SEAT at all.
#                   The broker assigns devices to seats by that tag, so on such
#                   a build every seat's devices are indistinguishable by name.
#                   seat.go already refuses a seat called "seat0" for precisely
#                   this reason, in the one case where it used to be possible.
#
# The right question is not what a device is called but who created it, and
# device_owner.py answers exactly that: a uinput device lives only as long as
# the descriptor that made it, that descriptor can be found, and the owner's
# cgroup names the container. That check cannot run here. systemd-udevd runs
# its workers behind a syscall filter that blocks pidfd_open and pidfd_getfd,
# which is what reading a foreign descriptor needs, so the helper answers
# "unknown" from inside udev and "container" from anywhere else. Measured, not
# assumed:
#
#     systemd-run -p SystemCallFilter="@system-service @module @raw-io" \
#         device_owner.py --udev event29     ->  POLYSEAT_OWNER=unknown
#     device_owner.py --udev event29         ->  POLYSEAT_OWNER=container
#
# So the structural answer is enforced by the broker instead, which already has
# it and runs without that filter. This file is the fast path: it closes the
# window to zero for everything on the list, and the broker closes the case of
# everything that is not, within one poll interval. Adding a name here is
# therefore an optimisation, and forgetting to is no longer a hole.
#
# Stripping ID_INPUT* alone is not enough. Those devices also carry the
# "uaccess" tag, and systemd-logind then grants the active desktop user an ACL
# on the node. That is how a seat's gamepad ended up readable on the host even
# though libinput ignored it: games and Steam open evdev nodes directly.
#
# So the tag goes as well, and ownership is pinned to root. The seats are
# unaffected: Incus creates its own node inside the container with its own
# mode, and the broker only reads /sys.
# Structural, at the moment the device is created, for everything a seat makes
# through uhid. That is every gamepad, and it is the case names cannot reach:
# a raw HID node has no name attribute for a pattern to match on, so it stayed
# open to the desktop until the broker noticed, which is half a second and
# quite long enough for a program that watches for new devices. The host's
# Steam was found holding a seat's controller open exactly that way.
#
# The observer writes down which container created each uhid device the moment
# the kernel makes it, keyed by the HID id that is also part of every path
# underneath. Reading that file is a thing udev's workers are allowed to do,
# unlike asking a foreign process what it made, which needs pidfd_getfd and is
# blocked by their syscall filter. So this half of the structural answer can be
# given here and the uinput half still cannot.
#
# A controller the host itself pairs over Bluetooth is also a uhid device, and
# the observer has no record of it, so it comes back unknown and is left alone.
SUBSYSTEM=="input|hidraw", DEVPATH=="*/uhid/*", \
  IMPORT{program}="/usr/local/lib/polyseat/device_owner.py --udev $devpath"
SUBSYSTEM=="input|hidraw", ENV{POLYSEAT_OWNER}=="container", GOTO="polyseat_hide"

SUBSYSTEM=="input", ATTRS{name}=="polyseat:*",      GOTO="polyseat_hide"
SUBSYSTEM=="input", ATTRS{name}=="*passthrough*",   GOTO="polyseat_hide"
SUBSYSTEM=="input", ATTRS{name}=="Sunshine*",       GOTO="polyseat_hide"
SUBSYSTEM=="input", ATTRS{name}=="libvirtualhid*",  GOTO="polyseat_hide"

# The same devices seen as raw HID, which is a different subsystem and was
# missed entirely.
#
# A gamepad made through uhid appears twice: once under /dev/input and once as
# /dev/hidrawN. Sunshine ships udev rules of its own that hand both to the
# desktop user, which is right for a Sunshine running on this machine and wrong
# for one running in a seat, and this file only ever looked at the input half.
# So the event node was pinned to root while its hidraw sibling kept an access
# control entry for the desktop user, and a seat's controller reached the host's
# Steam, which is exactly how Steam reads a DualSense.
SUBSYSTEM=="hidraw", ATTRS{name}=="polyseat:*",      GOTO="polyseat_hide"
SUBSYSTEM=="hidraw", ATTRS{name}=="*passthrough*",   GOTO="polyseat_hide"
SUBSYSTEM=="hidraw", ATTRS{name}=="Sunshine*",       GOTO="polyseat_hide"
SUBSYSTEM=="hidraw", ATTRS{name}=="libvirtualhid*",  GOTO="polyseat_hide"
GOTO="polyseat_end"

LABEL="polyseat_hide"
ENV{ID_INPUT}="", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_MOUSE}="", \
  ENV{ID_INPUT_KEYBOARD}="", ENV{ID_INPUT_KEY}="", ENV{ID_INPUT_TOUCHSCREEN}="", \
  ENV{ID_INPUT_TABLET}="", ENV{LIBINPUT_IGNORE_DEVICE}="1"
TAG-="uaccess", TAG-="seat"
OWNER="root", GROUP="root", MODE="0600"

LABEL="polyseat_end"
